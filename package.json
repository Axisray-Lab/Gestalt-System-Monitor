{
  "name": "gestalt-system-monitor",
  "version": "0.0.1",
  "private": true,
  "description": "LAN match monitor for Gestalt System matches — Three.js map wireframe + vehicle telemetry with automatic LAN discovery.",
  "type": "module",
  "workspaces": [
    "packages/protocol",
    "packages/agent",
    "packages/web",
    "packages/desktop"
  ],
  "scripts": {
    "dev": "npm run dev -w @gsm/web",
    "agent": "npm run start -w @gsm/agent --",
    "agent:mock": "npm run mock -w @gsm/agent --",
    "agent:scenario": "npm run scenario -w @gsm/agent --",
    "agent:replay": "npm run replay -w @gsm/agent --",
    "generate:rmuc2026-pages": "node packages/agent/src/rmuc2026-pages-replay.mjs",
    "audit:rmuc2026-pages": "node packages/agent/src/rmuc2026-pages-replay.mjs --audit-only",
    "verify:rmuc2026-pages": "node packages/agent/src/rmuc2026-pages-replay.mjs --validate-only",
    "verify:rmuc2026-pages-assets": "node packages/agent/src/rmuc2026-pages-replay.mjs --verify-assets-only",
    "build": "npm run build -w @gsm/web",
    "build:web": "npm exec -w @gsm/web -- vite build",
    "desktop:dev": "npm run dev -w @gsm/desktop",
    "desktop:build": "npm run build:web && npm run build -w @gsm/desktop",
    "test": "npm run test -w @gsm/agent && npm run test -w @gsm/web",
    "typecheck": "npm run typecheck -w @gsm/web && npm run typecheck -w @gsm/agent"
  },
  "license": "UNLICENSED"
}
